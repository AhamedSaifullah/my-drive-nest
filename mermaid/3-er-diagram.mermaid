erDiagram
  USER ||--o{ SESSION : "has"
  USER ||--o{ OAUTH_STATE : "starts"
  USER ||--o{ CLOUD_ACCOUNT : "links"
  USER ||--o{ FILE : "owns"
  CLOUD_ACCOUNT ||--o{ FILE : "contains"
  CLOUD_ACCOUNT ||--o{ SYNC_JOB : "runs"

  USER {
    ObjectId _id PK
    string name
    string email UK "lowercase"
    string passwordHash "argon2 or bcrypt"
    string status "active, disabled"
    date lastLoginAt
    date createdAt
    date updatedAt
  }

  SESSION {
    ObjectId _id PK
    ObjectId userId FK
    string refreshTokenHash "never store raw token"
    string deviceName
    string ip
    date expiresAt "TTL index"
    date revokedAt
    date createdAt
  }

  OAUTH_STATE {
    ObjectId _id PK
    string nonce UK
    ObjectId userId FK
    string provider
    date expiresAt "TTL index"
    date usedAt
  }

  CLOUD_ACCOUNT {
    ObjectId _id PK
    ObjectId userId FK
    string provider "google, dropbox, jio"
    string providerAccountId "provider user id"
    string email
    string displayName
    array scopes
    object accessTokenEnc "iv, tag, data, keyVersion"
    object refreshTokenEnc "iv, tag, data, keyVersion"
    date tokenExpiresAt
    string status "active, needs_reauth, unlinked"
    string lastError
    object sync "status, lastSyncedAt, cursor"
    object quota "used, total"
    date linkedAt
    date unlinkedAt
  }

  SYNC_JOB {
    ObjectId _id PK
    ObjectId cloudAccountId FK
    string type "full, incremental"
    string status "queued, running, done, failed"
    number filesProcessed
    string error
    date startedAt
    date finishedAt
  }

  FILE {
    ObjectId _id PK
    ObjectId userId FK "denormalized for fast dashboard"
    ObjectId cloudAccountId FK
    string provider
    string providerFileId
    string name
    string mimeType
    string extension
    string category "image, video, audio, document, other"
    boolean isFolder
    number size
    string checksum
    array parentIds
    string webViewLink
    boolean hasThumbnail
    date createdTime
    date modifiedAt
    boolean trashed
    date syncedAt
  }
